# Database
DATABASE_URL="postgresql://autoclaim:autoclaim@localhost:5432/autoclaim?schema=public"

# Feishu App (from developer console: https://open.feishu.cn)
FEISHU_APP_ID="cli_your_app_id"
FEISHU_APP_SECRET="your_app_secret"
FEISHU_BASE_URL="https://open.feishu.cn"

# Feishu Bitable (department sync data source)
FEISHU_BITABLE_TOKEN="your_bitable_token"
FEISHU_DEPT_TABLE_ID="your_table_id"

# Feishu Approval
FEISHU_APPROVAL_CODE="your_approval_code"
FEISHU_VERIFICATION_TOKEN=""
FEISHU_ENCRYPT_KEY=""

# App
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="https://your-server-ip:8443"
NEXT_PUBLIC_FEISHU_APP_ID="cli_your_app_id"

# HTTPS port
HTTPS_PORT=8443

# Super admin open_id (cannot be removed via Settings UI)
SUPER_ADMIN_UID="ou_your_super_admin_open_id"
NEXT_PUBLIC_SUPER_ADMIN_UID="ou_your_super_admin_open_id"
