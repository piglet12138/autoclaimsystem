# Nginx reverse proxy config for autoclaim with self-signed HTTPS
# Required for Feishu webhook callback on intranet
#
# Place this in /etc/nginx/sites-available/autoclaim
# and symlink to /etc/nginx/sites-enabled/

server {
    listen 443 ssl;
    server_name autoclaim.internal;

    ssl_certificate     /path/to/certs/server.crt;
    ssl_certificate_key /path/to/certs/server.key;

    # TLS settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # File upload size (matches app's 10MB limit)
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Serve uploaded files
    location /uploads/ {
        alias /path/to/autoclaim/uploads/;
        expires 30d;
    }
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name autoclaim.internal;
    return 301 https://$server_name$request_uri;
}
